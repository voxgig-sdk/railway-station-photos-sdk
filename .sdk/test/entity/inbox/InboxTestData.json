                    },
                    "state": {
                      "enum": [
                        "REVIEW",
                        "LAT_LON_OUT_OF_RANGE",
                        "NOT_ENOUGH_DATA",
                        "UNSUPPORTED_CONTENT_TYPE",
                        "PHOTO_TOO_LARGE",
                        "PHOTO_UPLOAD_NOT_ALLOWED",
                        "COUNTRY_DISABLED",
                        "CONFLICT",
                        "UNAUTHORIZED",
                        "ERROR"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "authorization failed"
          },
          "403": {
            "content": {},
            "description": "forbidden"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "General error message",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
