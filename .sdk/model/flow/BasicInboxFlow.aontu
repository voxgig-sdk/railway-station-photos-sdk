# BasicInboxFlow

main: kit: flow: BasicInboxFlow:
{
  entity: "inbox",
  kind: "basic",
  name: "BasicInboxFlow",
  step: [
    {
      i: {
        ref: "inbox_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "inbox_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "inbox_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "inbox01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "inbox_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInboxFlow"
}