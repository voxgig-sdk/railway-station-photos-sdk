# Entity: o_auth_token

main: kit: entity: o_auth_token: {

  alias: field: {}

  fields: {
    access_token: {
      h: "Access Token"
      n: "access_token"
      r: true
      t: "`$STRING`"
    }
    client_id: {
      h: "Client Id"
      n: "client_id"
      r: true
      t: "`$STRING`"
    }
    code: {
      h: "Code"
      n: "code"
      r: false
      t: "`$STRING`"
    }
    code_verifier: {
      h: "Code Verifier"
      n: "code_verifier"
      r: false
      t: "`$STRING`"
    }
    expires_in: {
      fo: "int64"
      h: "Expires In"
      n: "expires_in"
      r: false
      t: "`$INTEGER`"
    }
    grant_type: {
      h: "Grant Type"
      n: "grant_type"
      r: true
      t: "`$STRING`"
    }
    redirect_uri: {
      fo: "uri"
      h: "Redirect Uri"
      n: "redirect_uri"
      r: true
      t: "`$STRING`"
    }
    refresh_token: {
      h: "Refresh Token"
      n: "refresh_token"
      r: false
      t: "`$STRING`"
    }
    scope: {
      h: "Scope"
      n: "scope"
      r: true
      t: "`$STRING`"
    }
    token_type: {
      h: "Token Type"
      n: "token_type"
      r: true
      t: "`$STRING`"
    }
  }

  name: "o_auth_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /oauth2/token"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "Authorization"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/oauth2/token"
          q: {
            exist: [
              "authorization"
            ]
          }
          rb: {
            fields: [
              {
                name: "client_id"
              }
              {
                name: "code"
              }
              {
                name: "code_verifier"
              }
              {
                name: "grant_type"
              }
              {
                name: "redirect_uri"
              }
              {
                name: "refresh_token"
              }
            ]
            kind: "form"
            media: "application/x-www-form-urlencoded"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "oauth2"
            }
            {
              lit: "token"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
