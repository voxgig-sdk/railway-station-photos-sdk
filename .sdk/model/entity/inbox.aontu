# Entity: inbox

main: kit: entity: inbox: {

  alias: field: {}

  fields: {
    comment: {
      h: "Comment"
      n: "comment"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      t: "`$STRING`"
    }
    countryCode: {
      h: "Country Code"
      n: "countryCode"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "a two character country code"
      t: "`$STRING`"
    }
    crc32: {
      fo: "int64"
      h: "Crc32"
      n: "crc32"
      r: false
      sh: "CRC32 checksum of the uploaded photo"
      t: "`$INTEGER`"
    }
    createdAt: {
      fo: "int64"
      h: "Created At"
      n: "createdAt"
      r: false
      t: "`$INTEGER`"
    }
    filename: {
      h: "Filename"
      n: "filename"
      r: false
      sh: "filename in inbox"
      t: "`$STRING`"
    }
    id: {
      fo: "int64"
      h: "Id"
      n: "id"
      op: {
        list: {
          req: true
          type: "`$INTEGER`"
        }
      }
      r: false
      t: "`$INTEGER`"
    }
    inboxUrl: {
      h: "Inbox Url"
      n: "inboxUrl"
      r: false
      sh: "url of the photo in the inbox"
      t: "`$STRING`"
    }
    inbox_state_queries: {
      h: "Inbox State Queries"
      n: "inbox_state_queries"
      r: false
      sh: "Inbox state query request"
      t: "`$ARRAY`"
    }
    lat: {
      fo: "double"
      h: "Lat"
      n: "lat"
      r: false
      sh: "new latitude value for the station"
      t: "`$NUMBER`"
    }
    lon: {
      fo: "double"
      h: "Lon"
      n: "lon"
      r: false
      sh: "new longitude value for the station"
      t: "`$NUMBER`"
    }
    message: {
      h: "Message"
      n: "message"
      r: false
      t: "`$STRING`"
    }
    newLat: {
      fo: "double"
      h: "New Lat"
      n: "newLat"
      r: false
      t: "`$NUMBER`"
    }
    newLon: {
      fo: "double"
      h: "New Lon"
      n: "newLon"
      r: false
      t: "`$NUMBER`"
    }
    newTitle: {
      h: "New Title"
      n: "newTitle"
      r: false
      t: "`$STRING`"
    }
    photoId: {
      fo: "int64"
      h: "Photo Id"
      n: "photoId"
      r: false
      sh: "Unique id of a photo, can be used for WRONG_PHOTO and PHOTO_OUTDATED type."
      t: "`$INTEGER`"
    }
    problemReportType: {
      h: "Problem Report Type"
      n: "problemReportType"
      r: false
      sh: "types of problem reports"
      t: "`$STRING`"
    }
    rejectedReason: {
      h: "Rejected Reason"
      n: "rejectedReason"
      r: false
      t: "`$STRING`"
    }
    state: {
      h: "State"
      n: "state"
      r: true
      t: "`$STRING`"
    }
    stationId: {
      h: "Station Id"
      n: "stationId"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "a new title for the station"
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "types of problem reports"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "inbox"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "inbox_state_queries"
          ]
          co: {
            id: "POST /userInbox"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "Authorization"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/userInbox"
          q: {
            exist: [
              "authorization"
              "inbox_state_queries"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "userInbox"
            }
          ]
          t: {
            req: "`reqdata.inbox_state_queries`"
            res: "`body`"
          }
        }
        {
          bf: [
            "comment"
            "countryCode"
            "lat"
            "lon"
            "photoId"
            "stationId"
            "title"
            "type"
          ]
          co: {
            id: "POST /reportProblem"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "Authorization"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/reportProblem"
          q: {
            exist: [
              "authorization"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "reportProblem"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /userInbox"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "Authorization"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "show_completed_entry"
                or: "showCompletedEntries"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "GET"
          o: "/userInbox"
          q: {
            exist: [
              "authorization"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "userInbox"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /userInbox/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "DELETE"
          o: "/userInbox/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "userInbox"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
