# Entity: profile

main: kit: entity: profile: {

  alias: field: {}

  fields: [
    {
      name: "admin"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "anonymous"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      format: "email"
      name: "email"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      type: "`$STRING`"
    }
    {
      name: "emailVerified"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "license"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "the only accepted type is \"CC0 1.0 Universell (CC0 1.0)\", the others are listed for backward compatibility"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "link"
      req: false
      type: "`$STRING`"
    }
    {
      name: "newPassword"
      req: true
      type: "`$STRING`"
    }
    {
      name: "nickname"
      req: true
      type: "`$STRING`"
    }
    {
      name: "photoOwner"
      op: {
