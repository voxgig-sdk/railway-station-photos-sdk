# Entity: profile

main: kit: entity: profile: {

  alias: field: {}

  fields: [
    {
      name: "admin"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "anonymous"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      format: "email"
      name: "email"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      type: "`$STRING`"
    }
    {
      name: "emailVerified"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "license"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "the only accepted type is \"CC0 1.0 Universell (CC0 1.0)\", the others are listed for backward compatibility"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "link"
      req: false
      type: "`$STRING`"
    }
    {
      name: "newPassword"
      req: true
      type: "`$STRING`"
    }
    {
      name: "nickname"
      req: true
      type: "`$STRING`"
    }
    {
      name: "photoOwner"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "sendNotifications"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "profile"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/changePassword"
          segments: [
            {
              lit: "changePassword"
            }
          ]
          select: {
            exist: [
              "authorization"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/myProfile"
          segments: [
            {
              lit: "myProfile"
            }
          ]
          select: {
            exist: [
              "authorization"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/resendEmailVerification"
          segments: [
            {
              lit: "resendEmailVerification"
            }
          ]
          select: {
            exist: [
              "authorization"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/myProfile"
          segments: [
            {
              lit: "myProfile"
            }
          ]
          select: {
            exist: [
              "authorization"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "token"
                orig: "token"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/emailVerification/{token}"
          segments: [
            {
              lit: "emailVerification"
            }
            {
              var: "token"
            }
          ]
          select: {
            exist: [
              "token"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/myProfile"
          segments: [
            {
              lit: "myProfile"
            }
          ]
          select: {
            exist: [
              "authorization"
            ]
          }
          transform: {
            req: "`reqdata`"
