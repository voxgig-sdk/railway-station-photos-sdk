# Entity: inbox_entry

main: kit: entity: inbox_entry: {

  alias: field: {}

  fields: [
    {
      name: "active"
      req: false
      short: "active flag provided by the user"
      type: "`$BOOLEAN`"
    }
    {
      name: "comment"
      req: true
      type: "`$STRING`"
    }
    {
      name: "countryCode"
      req: false
      short: "a two character country code"
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "createdAt"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "done"
      req: true
      short: "true if this photo was already imported or rejected"
      type: "`$BOOLEAN`"
    }
    {
      name: "filename"
      req: false
      short: "name of the file in inbox"
      type: "`$STRING`"
    }
    {
      name: "hasConflict"
      req: false
      short: "conflict with another upload or existing photo"
      type: "`$BOOLEAN`"
    }
    {
      name: "hasPhoto"
      req: true
      short: "this station has already a photo (conflict)"
      type: "`$BOOLEAN`"
    }
    {
      format: "int64"
      name: "id"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "inboxUrl"
      req: false
      short: "url of the photo in the inbox"
      type: "`$STRING`"
    }
    {
      name: "isProcessed"
      req: false
      short: "was this image process (e.g."
      type: "`$BOOLEAN`"
    }
    {
      format: "double"
      name: "lat"
      req: false
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "lon"
      req: false
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "newLat"
      req: false
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "newLon"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "newTitle"
      req: false
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "photoId"
      req: false
      short: "ID of the photo"
      type: "`$INTEGER`"
    }
    {
      name: "photographerEmail"
      req: false
      type: "`$STRING`"
    }
    {
      name: "photographerNickname"
      req: true
      type: "`$STRING`"
    }
    {
      name: "problemReportType"
      req: false
      short: "types of problem reports"
      type: "`$STRING`"
    }
    {
      name: "stationId"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "inbox_entry"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "authorization"
                orig: "authorization"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/adminInbox"
          segments: [
            {
              lit: "adminInbox"
            }
          ]
          select: {
            exist: [
              "authorization"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
