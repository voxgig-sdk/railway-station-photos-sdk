# Entity: oauth

main: kit: entity: oauth: {

  alias: field: {}

  fields: {
    token: {
      h: "Token"
      n: "token"
      r: true
      t: "`$STRING`"
    }
    token_type_hint: {
      h: "Token Type Hint"
      n: "token_type_hint"
      r: false
      t: "`$STRING`"
    }
  }

  name: "oauth"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /oauth2/revoke"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "authorization"
                or: "Authorization"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/oauth2/revoke"
          q: {
            exist: [
              "authorization"
            ]
          }
          rb: {
            fields: [
              {
                name: "token"
              }
              {
                name: "token_type_hint"
              }
            ]
            kind: "form"
            media: "application/x-www-form-urlencoded"
          }
          s: [
            {
              lit: "oauth2"
            }
            {
              lit: "revoke"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /oauth2/authorize"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "client_id"
                or: "client_id"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "code_challenge"
                or: "code_challenge"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "code_challenge_method"
                or: "code_challenge_method"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "redirect_uri"
                or: "redirect_uri"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "response_type"
                or: "response_type"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "scope"
                or: "scope"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "state"
                or: "state"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/oauth2/authorize"
          q: {
            exist: [
              "client_id"
              "redirect_uri"
              "response_type"
              "scope"
            ]
          }
          s: [
            {
              lit: "oauth2"
            }
            {
              lit: "authorize"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
